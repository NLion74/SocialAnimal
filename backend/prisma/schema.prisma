generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
}

enum SharePermission {
	busy
	titles
	full
}

enum FriendshipStatus {
	pending
	accepted
}

enum CalendarType {
	ics
	caldav
	google
	icloud
	outlook
	fastmail
}

model User {
	twoFactorMethod String @default("none")
	totpSecret String?
	totpLastStep BigInt?
	recoveryCodes String[] @default([])
	securitySetupRequired Boolean @default(false)
	authChallenges AuthChallenge[]
	id           String        @id @default(uuid())
	email        String        @unique
	passwordHash String
	salt         String        @default("")
	authVersion Int @default(0)
	passwordChangedAt DateTime?
	passwordResets PasswordReset[]
	name         String?
	avatar       String?
	createdAt    DateTime      @default(now())

	connections    Connection[]
	subscriptions  Subscription[]
	oauthFlows     OAuthFlow[]
	calendars      Calendar[]
	friendships    Friendship[]    @relation("User1")
	friendships2   Friendship[]    @relation("User2")
	calendarShares CalendarShare[] @relation("SharedWith")
	settings       UserSettings?
	isAdmin Boolean @default(false)
	accountRole String @default("normal")
	disabled Boolean @default(false)
	emailVerifiedAt DateTime?
	permissionsInitialized Boolean @default(false)
	rulesets PermissionRuleset[]
	emailVerification EmailVerification?
}

model AppSettings {
	requireTwoFactor Boolean @default(false)
	id                String  @id @default("global")
	registrationsOpen Boolean @default(true)
	inviteOnly Boolean @default(false)
	requireEmailVerification Boolean @default(false)
	maxCalendarsPerUser Int @default(25)
	minSyncIntervalMinutes Int @default(15)
	syncPastDays Int @default(90)
	syncFutureDays Int @default(365)
	defaultTimezone String @default("UTC")
	defaultFirstDayOfWeek String @default("monday")
	updatedAt         DateTime @updatedAt
}

model UserSettings {
	id                     String @id @default(uuid())
	userId                 String @unique
	user                   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
	firstDayOfWeek         String @default("monday")
	defaultSharePermission SharePermission @default(full)
	timezone               String @default("UTC")
	defaultTab             String @default("dashboard")
}

model InviteCode {
	label String?
	expiresAt DateTime?
	revokedAt DateTime?
	id        String    @id @default(uuid())
	code      String    @unique
	createdBy String
	usedBy    String?
	usedAt    DateTime?
	createdAt DateTime  @default(now())
}

model Calendar {
	id           String    @id @default(cuid())
	userId       String
	name         String
	type         CalendarType
	url          String?
	config       Json      @default("{}")
	syncInterval Int       @default(60)   // minutes, 0 = manual only
	lastSync     DateTime?
	connectionId String?
	remoteId     String?
	lastAttempt  DateTime?
	lastSuccess  DateTime?
	lastError    String?
	leaseUntil   DateTime?
	leaseOwner   String?
	connection   Connection? @relation(fields: [connectionId], references: [id])
	syncRuns     SyncRun[]
	subscriptions Subscription[]
	createdAt    DateTime  @default(now())
	updatedAt    DateTime  @updatedAt

	user   User            @relation(fields: [userId], references: [id])
	events Event[]
	shares CalendarShare[]

	@@unique([connectionId, remoteId])
}

model CalendarShare {
	expiresAt DateTime?
	id           String   @id @default(uuid())
	calendarId   String
	calendar     Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
	sharedWithId String
	sharedWith   User     @relation("SharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)
	permission SharePermission @default(full)
	rulesetId String?
	ruleset PermissionRuleset? @relation(fields: [rulesetId], references: [id], onDelete: Restrict)
	createdAt    DateTime @default(now())

	@@unique([calendarId, sharedWithId])
	@@index([sharedWithId])
}

model Event {
	isRecurring Boolean?
	id          String   @id @default(cuid())
	calendarId  String
	externalId  String?
	title       String
	description String?
	location    String?
	startTime   DateTime
	endTime     DateTime
	allDay      Boolean  @default(false)
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

	@@unique([calendarId, externalId])
}

model Friendship {
	id        String   @id @default(uuid())
	user1Id   String
	user1     User     @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
	user2Id   String
	user2     User     @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
	status FriendshipStatus @default(pending)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	sharedCalendars Boolean @default(false)

	@@unique([user1Id, user2Id])
	@@index([user1Id])
	@@index([user2Id])
}

model Connection {
	id String @id @default(uuid())
	userId String
	user User @relation(fields: [userId], references: [id], onDelete: Cascade)
	type CalendarType
	name String
	credentials String
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	calendars Calendar[]
	flows OAuthFlow[]
	@@index([userId])
}

model SyncRun {
	id String @id @default(uuid())
	calendarId String
	calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
	status String @default("queued")
	createdAt DateTime @default(now())
	startedAt DateTime?
	finishedAt DateTime?
	error String?
	eventsSynced Int?
	@@index([status, createdAt])
}

model Subscription {
	expiresAt DateTime?
	name String @default("Sharing link")
	rulesetId String?
	ruleset PermissionRuleset? @relation(fields: [rulesetId], references: [id], onDelete: Restrict)
	version Int @default(1)
	id String @id @default(uuid())
	tokenHash String @unique
	calendarId String
	calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
	issuerId String
	issuer User @relation(fields: [issuerId], references: [id], onDelete: Cascade)
	ceiling SharePermission
	revokedAt DateTime?
	createdAt DateTime @default(now())
	@@index([calendarId, issuerId])
}

model OAuthFlow {
	id String @id @default(uuid())
	stateHash String @unique
	userId String
	user User @relation(fields: [userId], references: [id], onDelete: Cascade)
	expiresAt DateTime
	consumedAt DateTime?
	connectionId String?
	connection Connection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model PermissionRuleset {
	id String @id @default(uuid())
	userId String
	user User @relation(fields: [userId], references: [id], onDelete: Cascade)
	name String
	seedKey String?
	fallback String
	rules Json @default("[]")
	version Int @default(1)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	shares CalendarShare[]
	subscriptions Subscription[]

	@@unique([userId, seedKey])
	@@index([userId])
}

model EmailVerification {
	id String @id @default(uuid())
	userId String @unique
	user User @relation(fields: [userId], references: [id], onDelete: Cascade)
	email String
	tokenHash String @unique
	expiresAt DateTime
	consumedAt DateTime?
	lastSentAt DateTime @default(now())
	windowStartedAt DateTime @default(now())
	requestCount Int @default(1)
}

model PasswordReset {
	id String @id @default(uuid())
	userId String
	user User @relation(fields: [userId], references: [id], onDelete: Cascade)
	email String
	tokenHash String @unique
	authVersion Int
	expiresAt DateTime
	@@index([userId])
}

model RecoveryMail {
	recipientHash String?
	status String @default("queued")
	userId String?
	finishedAt DateTime?
	lastError String?
	id String @id @default(uuid())
	kind String
	payload String
	createdAt DateTime @default(now())
	expiresAt DateTime
	availableAt DateTime @default(now())
	leaseUntil DateTime?
	attempts Int @default(0)
	@@index([availableAt])
}

model RecoveryThrottle {
	key String @id
	count Int @default(1)
	expiresAt DateTime
}

model AuthChallenge {
	id String @id
	userId String
	user User @relation(fields: [userId], references: [id], onDelete: Cascade)
	purpose String
	method String
	authVersion Int
	verifier String?
	secret String?
	attempts Int @default(0)
	createdAt DateTime @default(now())
	expiresAt DateTime
	@@index([userId, purpose])
}
