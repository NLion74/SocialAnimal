{
	"name": "socialanimal-backend",
	"version": "0.1.0",
	"description": "Social calendar sharing platform for friends",
	"main": "dist/index.js",
	"author": "NLion74",
	"license": "UNLICENSE",
	"scripts": {
		"dev": "tsx watch --clear-screen=false src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "eslint src --ext .ts",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:studio": "prisma studio",
		"prisma:push": "prisma db push && prisma generate",
		"prisma:reset": "prisma migrate reset",
		"client:generate": "npm run build && node scripts/generate-client.cjs",
		"test:database": "npm run build && node tests/database/fresh.mjs && vitest run tests/database/v1.test.ts tests/modules/sharing/preview.test.ts",
		"format": "node scripts/format.cjs",
		"database:setup": "node dist/setup-database.js"
	},
	"dependencies": {
		"@fastify/cors": "^11.2.0",
		"@fastify/jwt": "^10.0.0",
		"@fastify/rate-limit": "^11.2.0",
		"@js-temporal/polyfill": "^0.5.1",
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^7.4.2",
		"argon2": "^0.45.1",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.3.1",
		"fastify": "^5.0.0",
		"googleapis": "^171.4.0",
		"ical-generator": "^10.0.0",
		"ipaddr.js": "^2.5.0",
		"jsonwebtoken": "^9.0.0",
		"node-ical": "^0.25.4",
		"nodemailer": "^10.0.13",
		"pg": "^8.19.0",
		"re2js": "^2.8.6",
		"tsdav": "^2.1.8",
		"undici": "^7.30.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.4",
		"@types/bcrypt": "^6.0.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.3.3",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.18.0",
		"@typescript-eslint/eslint-plugin": "^8.56.1",
		"@typescript-eslint/parser": "^8.56.1",
		"@vitest/coverage-v8": "^4.0.18",
		"eslint": "^10.0.2",
		"prettier": "^3.9.9",
		"prisma": "^7.4.2",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"keywords": [
		"calendar",
		"social",
		"friends",
		"sharing",
		"ics"
	]
}
